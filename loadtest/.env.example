# loadtest/.env 로 복사해서 채운다 (.env는 gitignore). 값은 Grafana Cloud 포털 → 스택 → 각 서비스 Details
# 토큰(GC_TOKEN)은 여기 적지 않는다 → README 3단계처럼 PowerShell에서 보이지 않게 입력
GC_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GC_LOKI_USER=000000
GC_PROM_URL=https://prometheus-prod-XX-prod-ap-northeast-0.grafana.net/api/prom/push
GC_PROM_USER=000000
GC_OTLP_URL=https://otlp-gateway-prod-ap-northeast-0.grafana.net/otlp
GC_OTLP_USER=000000
