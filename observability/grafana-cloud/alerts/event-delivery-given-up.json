{
  "uid": "cartmate-event-delivery-given-up",
  "title": "이벤트 전달 포기 (Outbox · Inbox · DLT)",
  "ruleGroup": "cartmate-business",
  "folderUID": "__FOLDER_UID__",
  "orgID": 1,
  "condition": "C",
  "noDataState": "OK",
  "execErrState": "Error",
  "for": "0s",
  "labels": { "severity": "critical" },
  "annotations": {
    "summary": "서비스 간 이벤트 전달을 포기했습니다 (재시도 끝). 받는 쪽 처리가 빠졌을 수 있습니다.",
    "description": "Loki: {service=~\".+\", env!=\"loadtest\"} | json | event=~\"outbox.failed|inbox.failed|kafka.dlt\" → eventId · topic 확인, Kafka UI에서 DLT 메시지 확인"
  },
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": { "from": 300, "to": 0 },
      "datasourceUid": "__LOKI_UID__",
      "model": {
        "refId": "A",
        "queryType": "instant",
        "expr": "sum(count_over_time({service=~\".+\", env!=\"loadtest\"} | json | event=~\"outbox.failed|inbox.failed|kafka.dlt\" [5m]))"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last" }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [ { "evaluator": { "type": "gt", "params": [0] } } ]
      }
    }
  ]
}
