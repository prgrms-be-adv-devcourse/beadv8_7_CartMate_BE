{
  "uid": "cartmate-payment-compensate-failed",
  "title": "결제 보상(되돌리기) 실패",
  "ruleGroup": "cartmate-business",
  "folderUID": "__FOLDER_UID__",
  "orgID": 1,
  "condition": "C",
  "noDataState": "OK",
  "execErrState": "Error",
  "for": "0s",
  "labels": { "severity": "critical" },
  "annotations": {
    "summary": "결제 되돌리기가 실패했습니다. 돈이 어긋났을 수 있어 수동 확인이 필요합니다.",
    "description": "Loki: {service=~\".+\", env!=\"loadtest\"} | json | event=~\"payment.compensate.*\" | result=\"FAILED\" → traceId로 Tempo 확인"
  },
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": { "from": 300, "to": 0 },
      "datasourceUid": "__LOKI_UID__",
      "model": {
        "refId": "A",
        "queryType": "instant",
        "expr": "sum(count_over_time({service=~\".+\", env!=\"loadtest\"} | json | event=~\"payment.compensate|payment.compensate.request\" | result=\"FAILED\" [5m]))"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last" }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [ { "evaluator": { "type": "gt", "params": [0] } } ]
      }
    }
  ]
}
